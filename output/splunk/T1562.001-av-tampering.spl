(Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*Set-MpPreference*", "*DisableRealtimeMonitoring*", "*DisableIOAVProtection*", "*DisableBehaviorMonitoring*", "*Add-MpPreference*", "*ExclusionPath*")) OR (Image="*\\sc.exe" CommandLine IN ("*WinDefend*", "*stop*", "*delete*")) OR (Image="*\\reg.exe" CommandLine IN ("*Windows Defender*", "*DisableAntiSpyware*", "*DisableAntiVirus*"))
